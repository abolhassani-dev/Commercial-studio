# ── کلیدهای API ─────────────────────────────────────────────
# این فایل را کپی کن به  .env.local  و کلیدها را داخلش بگذار.
# بدون هیچ کلیدی هم سیستم کار می‌کند (حالت «بسته پرامپت»):
# پرامپت نهایی را می‌سازد تا خودت در هر ابزاری paste کنی.

# fal.ai — دروازه اصلی مدل‌های تصویر و ویدیو (یک کلید، ده‌ها مدل)
# ساخت کلید: https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — صدای فارسی و کلون صدا
# ساخت کلید: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# Anthropic — برای نویسنده هوشمند سناریو و دیالوگ فارسی (اختیاری ولی خیلی موثر)
# ساخت کلید: https://console.anthropic.com
ANTHROPIC_API_KEY=

# رمز عبور اپ — اگر تنظیم شود، همه صفحات پشت صفحه ورود قفل می‌شوند
# (روی سرور/Vercel حتماً تنظیم کن؛ روی کامپیوتر شخصی لازم نیست)
APP_PASSWORD=

# ذخیره‌سازی ابری Vercel Blob — روی Vercel خودکار ست می‌شود؛ دستی لازم نیست
# BLOB_READ_WRITE_TOKEN=
